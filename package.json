{
    "name": "gvg-helper",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "discord:check-deps": "node src/discord-check-dependencies.ts",
        "isntall:ffmpeg": "node node_modules/ffmpeg-static/install.js",
        "dev": "bun run deploy && bun src/index.ts",
        "dev:watch": "bun run deploy && bun --watch src/index.ts",
        "deploy": "bun run src/deploy-commands.ts",
        "deploy:clean": "bun run src/deploy-commands.ts --clean",
        "build": "tsc",
        "test": "bun test",
        "postinstall": "node node_modules/ffmpeg-static/install.js",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.2",
        "@types/bun": "latest",
        "@types/ffmpeg-static": "^5.1.0",
        "@types/node": "^26.1.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "ffmpeg-static": "^5.3.0",
        "google-tts-api": "^2.0.2",
        "opusscript": "^0.1.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "sodium": "^3.0.2",
        "sodium-native": "^4.3.1",
        "tweetnacl": "^1.0.3",
        "zod": "^4.4.3"
    }
}
